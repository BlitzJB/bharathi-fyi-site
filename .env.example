# Vercel AI Gateway key. Required for the chat to answer in local dev.
# Create one at: Vercel dashboard -> AI Gateway -> API keys.
# When deployed on Vercel, this is not needed (OIDC auth is automatic).
AI_GATEWAY_API_KEY=

# The model that serves every chat request (any AI Gateway model id).
CHAT_MODEL=zai/glm-5.3-flash
