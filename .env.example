# Vercel AI Gateway key. Required for the chat to answer in local dev.
# Create one at: Vercel dashboard -> AI Gateway -> API keys.
# When deployed on Vercel, this is not needed (OIDC auth is automatic).
AI_GATEWAY_API_KEY=

# The model that serves every chat request (any AI Gateway model id).
CHAT_MODEL=zai/glm-5.3-flash

# Upstash Redis over REST (Vercel Marketplace integration naming).
# Backs rate limits, token budgets, and the chat kill switch.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Upstash Vector (hybrid dense+BM25 index over the knowledgebase).
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Langfuse tracing (cloud project keys + region base URL).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Admission-control tuning (all optional; defaults shown).
# CHAT_RPM=8                        requests/min per caller
# CHAT_TOKENS_PER_DAY_IP=50000      token budget per caller per day
# CHAT_TOKENS_PER_DAY_GLOBAL=2000000  global daily token ceiling (spend proxy)
#
# Kill switch: set the Redis key "flags:chat:disabled" to any value to turn
# the assistant off without a deploy; delete the key to restore it.
# CHAT_MAX_ACTIVE_RUNS=4                bounded concurrency to the model (queue depth)
