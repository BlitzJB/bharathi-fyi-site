# Vercel AI Gateway key. Required for the chat to answer in local dev.
# Create one at: Vercel dashboard -> AI Gateway -> API keys.
# When deployed on Vercel, this is not needed (OIDC auth is automatic).
AI_GATEWAY_API_KEY=

# The paid anchor model. A capable free model (when the gateway offers one)
# is tried first, with this as the gateway-enforced fallback.
CHAT_MODEL=zai/glm-5.3-flash

# Bar a free model must clear to be used: its paid variant's output price
# in USD per million tokens. Raise it to be pickier, set very high to
# effectively disable free models.
FREE_MODEL_MIN_OUTPUT=1
